# Configuração da Resenha (servidor). Fica em /etc/resenha.env, legível só pelo administrador.
# Depois de mexer aqui:  sudo systemctl restart resenha
# Para ver o que o servidor entendeu:  sudo journalctl -u resenha -n 15 --no-pager

############################################################################
# OPÇÃO A: TURN da Cloudflare (hoje)
# Com isto ligado, só 2 pessoas podem transmitir a tela ao mesmo tempo
# (para poupar a cota gratuita). Tire o "#" das duas linhas e cole seus dados.
############################################################################
#CF_TURN_KEY_ID=COLE_AQUI_O_TURN_TOKEN_ID
#CF_TURN_API_TOKEN=COLE_AQUI_O_API_TOKEN

############################################################################
# OPÇÃO D: coturn no servidor de casa (quando você tiver IP público)
# 1) rode:  sudo bash deploy/instalar-turn.sh      (ele imprime as 2 linhas abaixo)
# 2) abra no roteador: UDP 3478, TCP 3478 e UDP 49152-49999 para este servidor
# 3) COLOQUE um "#" nas duas linhas CF_ acima (ou apague-as) e tire o "#" daqui
# Sem a Cloudflare, o limite de 2 transmissões some sozinho.
############################################################################
#TURN_URL=turn:SEU.IP.PUBLICO:3478?transport=udp,turn:SEU.IP.PUBLICO:3478?transport=tcp
#TURN_SECRET=COLE_AQUI_O_SEGREDO_QUE_O_SCRIPT_MOSTROU

############################################################################
# Opcional: forçar o limite de transmissões de tela, qualquer que seja o TURN
# (0 = sem limite). Sem esta linha: 2 com Cloudflare/ICE_URL, sem limite nos outros casos.
############################################################################
#MAX_SCREENS=2
